+#define LZ4_STATIC_ASSERT(c)                                                   \
+	{                                                                      \
+		enum { LZ4_static_assert = 1 / (int)(!!(c)) };                 \
+	} /* use after variable declarations */
+
+#if defined(LZ4_DEBUG) && (LZ4_DEBUG >= 2)
