+#if !defined(LZ4_STATIC_LINKING_ONLY_DISABLE_MEMORY_ALLOCATION)
+int LZ4_freeStream(LZ4_stream_t *LZ4_stream)
+{
+	if (!LZ4_stream)
+		return 0; /* support free on NULL */
+	DEBUGLOG(5, "LZ4_freeStream %p", LZ4_stream);
+	FREEMEM(LZ4_stream);
+	return (0);
+}
