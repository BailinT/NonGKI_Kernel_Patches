+				   iend - (16 +
+					   1 /*max lit + offset + nextToken*/)) {
+				/* We don't need to check oend, since we check it once for each loop below */
+				DEBUGLOG(7,
+					 "copy %u bytes in a 16-bytes stripe",
+					 (unsigned)length);
